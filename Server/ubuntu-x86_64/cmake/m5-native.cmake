# Fixed M5 dependency snapshot. Apply before find_package/pkg-config calls.
set(M5_NATIVE "${CMAKE_CURRENT_LIST_DIR}/../vendor/m5/native" CACHE PATH "Locked native M5 dependencies")
if(NOT EXISTS "${M5_NATIVE}/lib/libpango-1.0.0.dylib")
  message(FATAL_ERROR "Missing frozen M5 dependency snapshot; see provenance/m5/native-dependencies.json")
endif()
set(OPENSSL_ROOT_DIR "${M5_NATIVE}/packages/openssl@3" CACHE PATH "Frozen OpenSSL" FORCE)
set(SDL2_DIR "${M5_NATIVE}/packages/sdl2/lib/cmake/SDL2" CACHE PATH "Frozen SDL2" FORCE)
set(PKG_CONFIG_EXECUTABLE "${CMAKE_CURRENT_LIST_DIR}/../vendor/m5/build-tools/bin/pkg-config" CACHE FILEPATH "Frozen native pkgconf" FORCE)
file(GLOB M5_PKG_DIRS "${M5_NATIVE}/packages/*/lib/pkgconfig" "${M5_NATIVE}/packages/*/share/pkgconfig")
list(APPEND M5_PKG_DIRS "${M5_NATIVE}/lib/pkgconfig")
list(JOIN M5_PKG_DIRS ":" M5_PKG_PATH)
set(ENV{PKG_CONFIG_LIBDIR} "${M5_PKG_PATH}")
set(ENV{PKG_CONFIG_PATH} "")
file(GLOB M5_NATIVE_LIBS "${M5_NATIVE}/lib/*.dylib")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
foreach(lib IN LISTS M5_NATIVE_LIBS)
  get_filename_component(name "${lib}" NAME)
  configure_file("${lib}" "${CMAKE_BINARY_DIR}/bin/${name}" COPYONLY)
endforeach()
