target_compile_definitions(matchmaking PRIVATE MATCHMAKING_DLL NO_STEAM NO_STEAM_GAMECOORDINATOR NO_STRING_T VECTOR PROTECTED_THINGS_ENABLE)
target_compile_definitions(matchmakingbase PRIVATE NO_STEAM NO_STEAM_GAMECOORDINATOR NO_STRING_T VECTOR PROTECTED_THINGS_ENABLE)
foreach(tgt matchmaking matchmakingbase)
  target_include_directories(${tgt} PRIVATE "${SOURCE_ROOT}/matchmaking" "${SOURCE_ROOT}/game/shared" "${SOURCE_ROOT}/gcsdk/steamextra" "${SOURCE_ROOT}/common/xlast_csgo")
  target_link_libraries(${tgt} PRIVATE source_messages steam_api gcsdk_game)
endforeach()
target_link_libraries(matchmaking PRIVATE matchmakingbase)
m3_library(client SHARED)
target_compile_definitions(client PRIVATE CLIENT_DLL NO_STRING_T VECTOR CSTRIKE_CLIENT_DLL CSTRIKE_DLL GAMEUI_EMBEDDED GAMEUI_EXPORTS USE_ECONOMY_FEATURES PROTOBUF NO_STEAM_GAMECOORDINATOR NO_STEAM PROTECTED_THINGS_ENABLE)
target_include_directories(client PRIVATE "${SOURCE_ROOT}/game/client" "${SOURCE_ROOT}/game/client/game_controls" "${SOURCE_ROOT}/game/shared" "${SOURCE_ROOT}/game/shared/cstrike15" "${SOURCE_ROOT}/game/shared/cstrike15/control" "${SOURCE_ROOT}/game/client/cstrike15" "${SOURCE_ROOT}/game/client/cstrike15/control" "${SOURCE_ROOT}/game/client/cstrike15/VGUI" "${SOURCE_ROOT}/game/client/cstrike15/gameui" "${SOURCE_ROOT}/game/shared/econ" "${SOURCE_ROOT}/gcsdk/steamextra" "${SOURCE_ROOT}/utils/common" "${M3_VENDOR}/thirdparty/libpng-1.5.30")
target_link_libraries(client PRIVATE bitmap bonesetup choreoobjects dmxloader particles responserules tier2 tier3 source_messages steam_api vgui_controls matsys_controls kv3lib gcsdk_game png15 jpeg8 z)
add_dependencies(client source_messages)
target_link_libraries(engine PRIVATE togl vgui_controls videocfg)

