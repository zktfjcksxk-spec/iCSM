# M4 builds the original SDL/TOGL and VGUI client paths from local VPC.
set(CMAKE_OBJCXX_STANDARD 11)
find_package(SDL2 CONFIG REQUIRED PATHS "/opt/homebrew/opt/sdl2/lib/cmake/SDL2")
target_compile_definitions(source_platform INTERFACE USE_SDL)
get_target_property(SOURCE_SDL_INCLUDES SDL2::SDL2 INTERFACE_INCLUDE_DIRECTORIES)
target_include_directories(source_platform INTERFACE ${SOURCE_SDL_INCLUDES})
# The Intel-only 10.8 malloc instruction hook cannot apply to an ARM GPU/process.
list(FILTER VPC_togl_FILES EXCLUDE REGEX "/(intelglmallocworkaround\\.cpp|mach_override\\.c)$")
if(BUILD_M6)
  # The native console measures SDL logical window points for its font scale.
  target_link_libraries(vgui_controls PRIVATE SDL2::SDL2)
  set(VPC_togl_FILES
    "${CMAKE_CURRENT_LIST_DIR}/../compat/metal/source_math.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/../compat/metal/native_resources.mm"
    "${CMAKE_CURRENT_LIST_DIR}/../compat/metal/native_shaders.mm"
    "${CMAKE_CURRENT_LIST_DIR}/../compat/metal/source_device.mm"
    "${CMAKE_CURRENT_LIST_DIR}/../compat/metal/native_window.mm")
  target_sources(appframework PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../compat/metal/native_display.cpp")
  add_subdirectory("${CMAKE_CURRENT_LIST_DIR}/../metal-tools" "${CMAKE_BINARY_DIR}/metal-tools")
endif()
m3_library(togl SHARED)
target_compile_definitions(togl PRIVATE TOGL_DLL_EXPORT)
if(BUILD_M6)
  target_compile_options(togl PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>")
  set_target_properties(togl PROPERTIES OBJCXX_STANDARD 17 CXX_STANDARD 11 OUTPUT_NAME source_metal)
  target_link_libraries(togl PRIVATE m6_mojoshader "-framework Metal" "-framework QuartzCore" "-framework Foundation")
  set(SOURCE_GRAPHICS_FRAMEWORK "-framework Metal")
else()
  set(SOURCE_GRAPHICS_FRAMEWORK "-framework OpenGL")
endif()
target_link_libraries(togl PRIVATE tier2 ${SOURCE_GRAPHICS_FRAMEWORK} "-framework Cocoa" "-framework Carbon" "-framework Quartz" "-framework IOKit")
target_link_libraries(appframework PRIVATE togl "-framework Cocoa" ${SOURCE_GRAPHICS_FRAMEWORK} "-framework Carbon" "-framework IOKit" "-framework Quartz")
foreach(tgt inputsystem vgui2 vguimatsurface launcher)
  m3_library(${tgt} SHARED)
  target_link_libraries(${tgt} PRIVATE tier2 tier3 steam_api "-framework Carbon" )
endforeach()
target_compile_definitions(inputsystem PRIVATE NO_STRING_T PROTECTED_THINGS_ENABLE)
target_link_libraries(inputsystem PRIVATE "-framework IOKit" "-framework ForceFeedback")
target_compile_definitions(vgui2 PRIVATE DONT_PROTECT_FILEIO_FUNCTIONS)
target_include_directories(vgui2 PRIVATE "${SOURCE_ROOT}/thirdparty")
m3_library(vgui_surfacelib STATIC)
target_link_libraries(vgui_surfacelib PRIVATE tier2 "-framework Carbon" "-framework CoreGraphics" "-framework CoreText")
target_compile_definitions(vguimatsurface PRIVATE VGUIMATSURFACE_DLL_EXPORT GAMEUI_EXPORTS BENCHMARK DONT_PROTECT_FILEIO_FUNCTIONS PROTECTED_THINGS_ENABLE)
target_include_directories(vguimatsurface PRIVATE "${SOURCE_ROOT}/vgui2/src")
target_link_libraries(vguimatsurface PRIVATE vgui_surfacelib bitmap vtf vgui_controls "-framework CoreText" "-framework CoreGraphics")
target_link_libraries(vgui2 PRIVATE vgui_surfacelib bitmap vtf vgui_controls)
target_compile_definitions(launcher PRIVATE LAUNCHERONLY NO_STEAM)
target_link_libraries(launcher PRIVATE appframework togl "-framework Cocoa" ${SOURCE_GRAPHICS_FRAMEWORK} "-framework IOKit")
add_executable(csgo_client ${VPC_launcher_main_FILES})
target_link_libraries(csgo_client PRIVATE source_platform)
add_dependencies(csgo_client launcher)
m3_library(videocfg STATIC)
target_include_directories(videocfg PRIVATE "${SOURCE_ROOT}/public/videocfg")
target_link_libraries(videocfg PRIVATE tier2)
m3_library(shaderapidx9 SHARED)
target_compile_definitions(shaderapidx9 PRIVATE SHADERAPIDX9 SHADER_DLL_EXPORT PROTECTED_THINGS_ENABLE SOURCE_MATERIALSYSTEM_SPLIT)
target_include_directories(shaderapidx9 PRIVATE "${SOURCE_ROOT}/materialsystem")
target_link_libraries(shaderapidx9 PRIVATE bitmap vtf videocfg tier2 togl bz2 ${SOURCE_GRAPHICS_FRAMEWORK} "-framework Cocoa")
set(VPC_shaderlib_dynamic_FILES ${VPC_shaderlib_FILES})
m3_library(shaderlib_dynamic STATIC)
target_include_directories(shaderlib_dynamic PRIVATE "${SOURCE_ROOT}/materialsystem")
target_compile_definitions(shaderlib_dynamic PRIVATE FAST_MATERIALVAR_ACCESS SOURCE_MATERIALSYSTEM_SPLIT)
foreach(tgt stdshader_dx9 stdshader_dbg)
  m3_library(${tgt} SHARED)
  target_compile_definitions(${tgt} PRIVATE STDSHADER_DX9_DLL_EXPORT FAST_MATERIALVAR_ACCESS SOURCE_MATERIALSYSTEM_SPLIT)
  target_include_directories(${tgt} PRIVATE "${SOURCE_ROOT}/materialsystem" "${SOURCE_ROOT}/materialsystem/stdshaders/fxctmp9" "${SOURCE_ROOT}/materialsystem/stdshaders/vshtmp9")
  target_link_libraries(${tgt} PRIVATE shaderlib_dynamic tier2)
endforeach()
foreach(tgt matsys_controls matchmakingbase)
  m3_library(${tgt} STATIC)
  target_link_libraries(${tgt} PRIVATE tier2 tier3 vgui_controls)
endforeach()
