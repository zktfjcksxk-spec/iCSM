target_link_libraries(soundsystem_lowlevel PRIVATE tier2 SDL2::SDL2)
target_link_libraries(vguimatsurface PRIVATE dmxloader)
target_link_libraries(engine PRIVATE matsys_controls soundsystem_lowlevel jpeg8 "-framework CoreAudio" "-framework AudioToolbox" "-framework AudioUnit" "-framework OpenAL")
# M4 retains the original non-HRTF audio path; 2019 Phonon API restoration is M5.
foreach(src IN LISTS VPC_engine_FILES)
 if(src MATCHES "/audio/private/")
  set_property(SOURCE "${src}" APPEND PROPERTY COMPILE_DEFINITIONS SOURCE_NO_STEAMAUDIO)
 endif()
endforeach()

