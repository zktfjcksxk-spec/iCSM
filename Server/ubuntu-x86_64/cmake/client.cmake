 target_link_libraries(${tgt} PRIVATE SDL2::SDL2)
endforeach()

add_custom_command(OUTPUT "${CMAKE_BINARY_DIR}/generated/vscript_client_nut.h"
 COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../scripts/embed_script.py"
 "${SOURCE_ROOT}/game/client/vscript_client.nut" "${CMAKE_BINARY_DIR}/generated/vscript_client_nut.h" "g_Script_vscript_client"
 DEPENDS "${SOURCE_ROOT}/game/client/vscript_client.nut" "${CMAKE_CURRENT_LIST_DIR}/../scripts/embed_script.py" VERBATIM)
