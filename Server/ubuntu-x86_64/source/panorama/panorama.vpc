		$File "$SRCDIR\public\panorama\uijsregistration.h"
		$File "$SRCDIR\public\panorama\uimetaprogramming.h"
		$FILE "$SRCDIR\public\panorama\uischeduleddel.h"
		$File "$SRCDIR\public\panorama\uitoplevelwindow.h"
//JMC		$File "$SRCDIR\public\panorama\uitoplevelwindowoverlay.h"
