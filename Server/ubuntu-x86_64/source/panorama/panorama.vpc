//-----------------------------------------------------------------------------
//	PANORAMA.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR				".."
$Macro OUTBINDIR			"$SRCDIR\..\game\bin"

$Macro MILESBASEDIR			"$SRCDIR\thirdparty\miles-9"

$Macro GENERATED_PROTO_DIR	"generated_proto_panorama"

$Include "$SRCDIR\vpc_scripts\source_dll_base.vpc"
$Include "$SRCDIR\vpc_scripts\protobuf_builder.vpc"

$include "$SRCDIR\external\external.vpc"
$include "$SRCDIR\external\$EXTERNALCRYPTOPP\external_cryptopp.vpc"

$Conditional "SPLIT_PANORAMA_TEXT" "1"

// V8_LINK_DEBUGGING_LIBS - note this only controls linking libs, debugging is turned
// on/off by V8_DEBUGGING_ENABLED in ctx_debug.h, so it can be turned off easily for perf analysis
$Conditional "V8_LINK_DEBUGGING_LIBS" "1"		[$WINDOWS && $DEVELOPMENT_ONLY]

$Macro PANORAMA_USE_S1WRAPPER "1"

$Configuration
{
	$General
	{
		// Steam wants dependencies setup for runtime rather than the bare minimum dependencies for build time. 
		$AdditionalProjectDependencies			"$BASE;chromemessages;mathlib;steammessages;libaudio;libvideo;steamclient_client" [$WINDOWS]
	}

	$Compiler
	{
		$ShowIncludes							"Yes (/showIncludes)" [$0]

		$PreprocessorDefinitions				"$BASE;_CLIENT;PANORAMA_EXPORTS;STEAM_API_NODLL;SOURCE2_PANORAMA_FIXME;SOURCE2_PANORAMA"
		$PreprocessorDefinitions				"$BASE;PANORAMA_USE_S1WRAPPER"
		$PreprocessorDefinitions				"$BASE;ALLOW_TEXT_MODE=1" [$CSTRIKE_TRUNK_BUILD||$CSTRIKE_STAGING_BUILD]
		$PreprocessorDefinitions				"$BASE;NOAUDIO" [$NOAUDIO]
		$PreprocessorDefinitions				"$BASE;UBUNTU" [$UBUNTU]

		$AdditionalIncludeDirectories			"steamextra\common;steamextra\public;$BASE"
		$AdditionalIncludeDirectories			"..\panorama_s1wrapper\thirdparty;$BASE"
		$AdditionalIncludeDirectories			"..\panorama_s1wrapper;$BASE"
		$AdditionalIncludeDirectories			"$BASE;$SRCDIR\panorama"
		$AdditionalIncludeDirectories			"$BASE;$GENERATED_PROTO_DIR"
		$AdditionalIncludeDirectories			"$BASE;..\public\panorama"
		$AdditionalIncludeDirectories			"$BASE;..\public"
		$AdditionalIncludeDirectories			"$BASE;..\public\tier1"
		$AdditionalIncludeDirectories			"$BASE;..\public\vstdlib"
		$AdditionalIncludeDirectories			"$BASE;..\common"
		$AdditionalIncludeDirectories			"$BASE;..\public\steam"
		$AdditionalIncludeDirectories			"$BASE;..\thirdparty"
		$AdditionalIncludeDirectories			"$BASE;..\common\steamui"
		$AdditionalIncludeDirectories			"$BASE;..\external\dx9sdk\Effects11\Inc\"
		$AdditionalIncludeDirectories			"$BASE;..\thirdparty\zlib"
		$AdditionalIncludeDirectories			"$BASE;..\thirdparty\libvpx-v1.1.0"
		$AdditionalIncludeDirectories			"$BASE;..\thirdparty\pango"				[!$SPLIT_PANORAMA_TEXT]
		$AdditionalIncludeDirectories			"$BASE;..\thirdparty\pango\freetype"	[!$SPLIT_PANORAMA_TEXT]
		$AdditionalIncludeDirectories			"$BASE;..\thirdparty\pango\glib"		[!$SPLIT_PANORAMA_TEXT]
		$AdditionalIncludeDirectories			"$BASE;..\thirdparty\sdl\include"
		$AdditionalIncludeDirectories			"$BASE;..\thirdparty\websocketpp"		[$V8_LINK_DEBUGGING_LIBS]
		$AdditionalIncludeDirectories			"$BASE;..\thirdparty\asio\include"		[$V8_LINK_DEBUGGING_LIBS]
		$AdditionalIncludeDirectories			"$BASE;..\thirdparty\cairo\include"
		$AdditionalIncludeDirectories			"$BASE;..\thirdparty\libparsifal-0.8.3\include"
				
		$Create/UsePrecompiledHeader			"Use Precompiled Header (/Yu)"
		$Create/UsePCHThroughFile				"stdafx.h" 
		
		$EnableC++Exceptions					"No"

		// necessary to force including debug information from stdafx.obj
		$AdditionalOptions						"$BASE /YlCUIEngine"

		$AdditionalOptions						"$BASE /FS"

		$DisableSpecificWarnings	"$BASE;4189"   [$WIN32]

	}

	$Linker
	{
		$AdditionalDependencies			"$BASE WS2_32.LIB shlwapi.lib odbc32.lib wsock32.lib winmm.lib setupapi.lib psapi.lib" [$WINDOWS]
		//$AdditionalDependencies			"$BASE iphlpapi.lib" [$WIN32]
		//$AdditionalDependencies			"$BASE ..\thirdparty\nvidia\nvapi\lib$PLATSUBDIR\nvapi.lib" [$WINDOWS && $PANORAMA_USE_S1WRAPPER]
		$AdditionalDependencies			"$BASE opengl32.lib" [$WINDOWS && $OGL]

		// SystemConfiguration must come before IOKit due to a bug in the Apple SDK that lets the linker bind to
		// symbols that were in SystemConfiguration pre 10.7, are in IOKit in 10.7. if the linker chooses the IOKit version, 
		// the resulting binary will fail to load on 10.5 
		$SystemFrameworks				"$BASE;Cocoa;SystemConfiguration;OpenGL;IOKit;DiskArbitration;Security;Carbon;AGL"
			$SystemLibraries                "z;iconv;" [$OSXALL]
                $SystemLibraries				"SDL2;Xtst;Xfixes;Xrandr;Xext;X11;GL" [$LINUXAll]

		// Due to vpxmt.lib we currently can't enable /safeseh in this project.
		$ImageHasSafeExceptionHandlers		"false" [$WINDOWS]
	}

}

$Project "panorama"
{
	$Folder "Resource Files"
	{
		$File "resource.h"
		$File "panorama.rc"
	}

	$Folder "Protobuf Files"
	{
		$File "steamextra\common\uifontfile_format.proto" [!$SPLIT_PANORAMA_TEXT]

		$Folder "Generated Files"
		{
			$DynamicFile "$GENERATED_PROTO_DIR\uifontfile_format.pb.cc" [!$SPLIT_PANORAMA_TEXT]
			{
				$Configuration
				{
					$Compiler 
					{
						$Create/UsePrecompiledHeader	"Not Using Precompiled Headers" [$WINDOWS]
					}
				}
			}
		}

	}

	$Folder "Public"
	{
		$File "$SRCDIR\public\panorama\panorama.h"
