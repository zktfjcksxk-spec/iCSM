	$Folder "Link Libraries"
	{
		$LibExternal	libprotobuf [!$VS2013 && !$VS2015]
		$Libexternal	$LIBPUBLIC\2013\libprotobuf [$VS2013]
		$Libexternal	$LIBPUBLIC\2015\libprotobuf [$VS2015]
		{
			$Configuration "Debug" { $ExcludedFromBuild "Yes" }
		}

		$Libexternal	$LIBPUBLIC\2015\debug\libprotobuf [$VS2015]
		{
			$Configuration "Release" { $ExcludedFromBuild "Yes" }
		}

		$Lib			"bitmap"
		$Lib			"vtf"

		$Lib	"$LIBPUBLIC\tier2"
		$Lib	"$LIBPUBLIC\tier3"
		$Lib	"$LIBPUBLIC\resourcefile"
		$Lib	"$LIBPUBLIC\socketlib"				[ $WINDOWS ]


		$ImplibExternal	steam_api					[ ( $WIN32 || $POSIX || $PS3 ) && !$NO_STEAM ]
		$ImplibExternal	steam_api64					[ $WIN64 && !$NO_STEAM ]

		$File "..\lib\common\bzip2.lib" [$WINDOWS && !$VS2015]
		$File "..\lib\common\vc14\bzip2.lib" [$WINDOWS && $VS2015]
		$Lib 	"$LIBCOMMON\jpeglib"
		$Lib	"$LIBPUBLIC\libz" [!$OSXALL]

		$File "..\lib\common\libpng\libpng.lib"	 [$WINDOWS && !$VS2015]
		$File "..\lib\common\libpng\2015\libpng.lib"	 [$WINDOWS && $VS2015]
		$LibExternal "$SRCDIR/lib/$PLATFORM/release/libpng"		[$POSIX]
		
		$File "$LIBPUBLIC\libprotobuf.a" [$POSIX]
		
		$File "$SRCDIR\lib\common\libeay32.lib"		[$WINDOWS && !$SPLIT_PANORAMA_TEXT]
		$File "$SRCDIR\lib\common\ssleay32.lib"		[$WINDOWS && !$SPLIT_PANORAMA_TEXT]
		$File "$SRCDIR\lib\common\$PLATFORM\libssl.a"		[$POSIX && !$SPLIT_PANORAMA_TEXT]

		$Lib	"$LIBPUBLIC\mathlib"

