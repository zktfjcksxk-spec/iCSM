		$File "$SRCDIR\lib\common\$PLATFORM\libv8_libbase.so"	[$LINUXALL]
		$File "$SRCDIR\lib\common\$PLATFORM\libv8_libplatform.so"	[$LINUXALL]
		$File "$SRCDIR\lib\common\$PLATFORM\libv8.so"	[$LINUXALL]

		$File "$SRCDIR\lib\common\$PLATFORM\libv8_libbase.dylib"	[$OSXALL]
		$File "$SRCDIR\lib\common\$PLATFORM\libv8_libplatform.dylib"	[$OSXALL]
		$File "$SRCDIR\lib\common\$PLATFORM\libv8.dylib"	[$OSXALL]

		$File "$SRCDIR\lib\common\$PLATFORM\2015\v8_libbase.dll.lib" [$WINDOWS && $VS2015]
		$File "$SRCDIR\lib\common\$PLATFORM\2015\v8_libplatform.dll.lib" [$WINDOWS && $VS2015]
		$File "$SRCDIR\lib\common\$PLATFORM\2015\v8.dll.lib" [$WINDOWS && $VS2015]

				
		$File "$SRCDIR\lib\common\$PLATFORM\v8_libbase.lib" [$WINDOWS && !$VS2015] \
			  "$SRCDIR\lib\common\$PLATFORM\v8_libplatform.lib" [$WINDOWS && !$VS2015] \
		      "$SRCDIR\lib\common\$PLATFORM\v8.lib" [$WINDOWS && !$VS2015]
		{
			$Configuration "Debug" { $ExcludedFromBuild "Yes" }
		}

		$File "$SRCDIR\lib\common\$PLATFORM\debug\v8_libbase.lib" [$WINDOWS && !$VS2015] \
			  "$SRCDIR\lib\common\$PLATFORM\debug\v8_libplatform.lib" [$WINDOWS && !$VS2015] \
		      "$SRCDIR\lib\common\$PLATFORM\debug\v8.lib" [$WINDOWS && !$VS2015]
		{
			$Configuration "Release" { $ExcludedFromBuild "Yes" }
		}

		$File "$SRCDIR\lib\common\parsifal.lib" [$WINDOWS]
		$File "$SRCDIR\lib\common\$PLATFORM\libparsifal.a" [$POSIX]
		$File "$SRCDIR\thirdparty\gperftools-2.0\.libs\libprofiler.so" [$GPROFILER]

		$DynamicFile "$SRCDIR\lib\common\$PLATFORM\video.lib" [$WIN32]
		$DynamicFile "$SRCDIR\lib\common\$PLATFORM\video64.lib" [$WIN64]
		
		$ImplibExternal "video" [$LINUXALL]
		$File "$SRCDIR\lib\common\$PLATFORM\libvideo.dylib" [$OSXALL]

		$DynamicFile "$SRCDIR\lib\common\pango-1.0.lib"		[$WINDOWS && !$SPLIT_PANORAMA_TEXT]
		$DynamicFile "$SRCDIR\lib\common\pangoft2-1.0.lib"	[$WINDOWS && !$SPLIT_PANORAMA_TEXT]
		$DynamicFile "$SRCDIR\lib\common\fontconfig.lib"		[$WINDOWS && !$SPLIT_PANORAMA_TEXT]
		$DynamicFile "$SRCDIR\lib\common\gobject-2.0.lib"		[$WINDOWS && !$SPLIT_PANORAMA_TEXT]
		$DynamicFile "$SRCDIR\lib\common\glib-2.0.lib"		[$WINDOWS && !$SPLIT_PANORAMA_TEXT]
		$DynamicFile "$SRCDIR\lib\common\libfreetype-6.lib"	[$WINDOWS && !$SPLIT_PANORAMA_TEXT]

		$ImpLib "$LIBCOMMON\pango-1.0"		[$OSXALL && !$SPLIT_PANORAMA_TEXT]
		$ImpLib "$LIBCOMMON\pangoft2-1.0"	[$OSXALL && !$SPLIT_PANORAMA_TEXT]
		$ImpLib "$LIBCOMMON\fontconfig"		[$OSXALL && !$SPLIT_PANORAMA_TEXT]
		$ImpLib "$LIBCOMMON\gobject-2.0"	[$OSXALL && !$SPLIT_PANORAMA_TEXT]
		$ImpLib "$LIBCOMMON\glib-2.0"		[$OSXALL && !$SPLIT_PANORAMA_TEXT]
		$ImpLib "$LIBCOMMON\freetype"		[$OSXALL && !$SPLIT_PANORAMA_TEXT]

		$ImpLib "cairo"

		$Implib togl [!$IS_LIB_PROJECT && $GL && !$DEDICATED]


	}
	
//APS	$include "$SRCDIR\external\libparsifal-0.8.3\parsifal_include.vpc"
//APS	$include "$SRCDIR\common\steamcommon_client_include.vpc"
}
