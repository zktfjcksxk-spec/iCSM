#include "common_ps_fxc.h"

sampler Tex1Sampler : register( s0 );
sampler Tex2Sampler : register( s1 );

const float4 g_Const0 : register( c0 );

#define g_offsetX g_Const0.x
#define g_offsetY g_Const0.y
#define g_time g_Const0.z
#define g_fadein g_Const0.w

#define g_HexHorz 10.0
#define g_HexVert 4.0

static const float3 desat = float3(0.3f, 0.59f, 0.11f);

struct PS_INPUT
{
	float2 vBaseUV : TEXCOORD0;
};

float4 main( PS_INPUT i ) : COLOR
{	
	float2 vUV = i.vBaseUV;
	
	vUV.x *= g_HexHorz;
	vUV.y *= g_HexVert;
	
	float4 cHexSample = tex2D( Tex2Sampler, vUV );
	
	//return float4( cHexSample.b, cHexSample.b, cHexSample.b, 1 );
	
	float2 vToHexCenter = (cHexSample.xy * 2.0) - 1.0;
	
	float2 vHexCenter = vUV + ( vToHexCenter * float2( 0.5, 1.0/3.0 ) );
	
	vHexCenter = vHexCenter * float2( 2.0, 2.0 );
	vHexCenter = floor(vHexCenter + 0.5) * float2( 0.5, 0.5 );
	
	vHexCenter.x /= g_HexHorz;
	vHexCenter.y /= g_HexVert;
	
	float flHexDistToCenter = 1.3 * length( vHexCenter - float2( 0.5, 0.45 ) );
	
	float flFade = 1.2 * g_fadein;
	//float flFade = 1.2 * ((sin( g_time ) * 0.5) + 0.5);
	//float flFade = 0.5;
	
	float flAlpha = 1.0 - flHexDistToCenter;
	
	float flRemappedAlpha = smoothstep( flFade, flFade - 0.15, flAlpha );
	flRemappedAlpha = lerp( 1.0 - cHexSample.a, flRemappedAlpha, 2.0 * abs( flRemappedAlpha - 0.5 ) );
	float flRemappedAlpha2 = smoothstep( flFade, flFade - 0.3, flAlpha );
	
	float flFrameBufferDesat = dot( desat.rgb, tex2D( Tex1Sampler, i.vBaseUV ).rgb ) - 0.5;
	
	float4 cOut = float4( flFrameBufferDesat.xxx * (1.0 - flRemappedAlpha2), flRemappedAlpha );
	
	return cOut;
}

