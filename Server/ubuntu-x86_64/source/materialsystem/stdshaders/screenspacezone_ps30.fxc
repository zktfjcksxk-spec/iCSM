#include "common_ps_fxc.h"

#define M_PI 3.141592653589f

sampler DepthSampler : register( s0 );
sampler Tex1Sampler : register( s1 );
sampler Tex2Sampler : register( s2 );
sampler Tex3Sampler : register( s3 );

const float4 g_Const0 : register( c0 );
const float4 g_Const1 : register( c1 );
const float4 g_Const2 : register( c2 );

const float4 g_Const5 : register( c5 );
#define g_worldOffset g_Const5.xy
#define g_worldScale g_Const5.zw

static const float3 desat = float3(0.3f, 0.59f, 0.11f);

#define g_vZoneOrigin				g_Const0.xyz
#define g_flTime					g_Const0.w
#define g_vCamera					g_Const1.xyz
#define g_flRadius					g_Const1.w

const float4x4 g_invViewMatrix : register( c15 );

#define g_flThickness				600.0f
#define g_flHalfThickness			300.0f
#define g_flPulserAlpha				0.1f
#define g_flPulserWidth				50
#define g_flPulserSeparation		450

struct PS_INPUT
{
	float2 vBaseUV : TEXCOORD0;
};

float3 posFromDepth( float2 vUV )
{
	float flDepth = tex2D( DepthSampler, vUV ).r;
	
	clip( 0.9999f - flDepth );
	
	float x = vUV.x * 2 - 1;
	float y = (1 - vUV.y) * 2 - 1;
	
	float4 vProjectedPos = float4(x, y, flDepth, 1.0f);
	float4 vPositionVS = mul(vProjectedPos, g_invViewMatrix);
	
	return (vPositionVS.xyz / vPositionVS.w);
}

float3 PhotoshopOverlay( float3 cBase, float3 cBlend )
{
	float3 cNew;
	cNew = step( 0.5, cBase );
	cNew = lerp( (cBase*cBlend*2), (1.0-(2.0*(1.0-cBase)*(1.0-cBlend))), cNew );
	return cNew;
}

float4 main( PS_INPUT i ) : COLOR
{
	float4 cOut = float4( 0, 0, 0, 1 );
	
	float3 worldPixelPos = posFromDepth( i.vBaseUV );
	
	float2 vProjectionUV = (worldPixelPos.xy + g_worldOffset) * g_worldScale;
	vProjectionUV.y = 1.0 - vProjectionUV.y;
	
	vProjectionUV.x += 0.0009765625;// fixme - not sure why we need the half-pixel offset
	vProjectionUV.y += 0.0009765625;// fixme - not sure why we need the half-pixel offset
	
	float flProjectionSample = tex2D( Tex1Sampler, vProjectionUV ).r;
	
	vProjectionUV.x = clamp( vProjectionUV.x, 0.0 + 0.01, 1.0 - 0.01 );
	vProjectionUV.y = clamp( vProjectionUV.y, 0.0 + 0.01, 1.0 - 0.01 );
	
	flProjectionSample += tex2D( Tex1Sampler, vProjectionUV + float2(0.01,0.001) ).r;
	flProjectionSample += tex2D( Tex1Sampler, vProjectionUV + float2(0.001,0.01) ).r;
	flProjectionSample += tex2D( Tex1Sampler, vProjectionUV + float2(-0.01,-0.001) ).r;
	flProjectionSample += tex2D( Tex1Sampler, vProjectionUV + float2(-0.001,-0.01) ).r;
	flProjectionSample *= 0.2;
	clip( flProjectionSample - (2.0/255.0) );
	
	float flCrush = smoothstep( (2.0/255.0), (32.0/255.0), flProjectionSample );
	float2 vNoiseUV = vProjectionUV * 50.0;
	vNoiseUV.x += worldPixelPos.z * 0.0001f;
	float flNoise = tex2D( Tex3Sampler, vNoiseUV ).g;
	
	//flNoise = fmod( flNoise - g_flTime + 1.0, 1.0 );
	//flNoise = lerp( flNoise, 1.0 - flNoise, fmod( flNoise - g_flTime + 1.0, 1.0 ) );
	
	flCrush = saturate( lerp( flCrush - flNoise, flCrush, pow(flCrush,4.0) ) ); 
	clip( flCrush - 0.002 );
	
	float flAlphaBorder = step(0.2, flCrush);
	cOut.a = smoothstep(0.0, 0.2, flCrush );
	
	float4 vFrameBuffer = tex2D( Tex2Sampler, i.vBaseUV );
	float flFrameBufferDesat = dot(desat.rgb, vFrameBuffer.rgb);
	flFrameBufferDesat = 0.5f * flFrameBufferDesat - fmod(flFrameBufferDesat,0.2f) * 0.2f;
	
	cOut.rgb = lerp( flFrameBufferDesat * 0.3, flFrameBufferDesat * smoothstep(0.1, 0.7, flCrush ), flAlphaBorder );
	
	float flEdgeHighlight = smoothstep( 1.0, 0.0, pow(flCrush,0.2) ) + smoothstep( 0.25, 0.1, flCrush );
	
	float flDistToCamera = length(g_vCamera - worldPixelPos);
	cOut.r += flEdgeHighlight * flAlphaBorder * smoothstep( 2500, 0, flDistToCamera );
	cOut.rgb = lerp( vFrameBuffer.rgb, cOut.rgb, smoothstep( 6000, 4000, flDistToCamera ) );
	
	cOut.a *= (
	smoothstep( 0.49, 0.46, abs( 0.5 - vProjectionUV.x ) ) *
	smoothstep( 0.49, 0.46, abs( 0.5 - vProjectionUV.y ) ) );
	
	//cOut.ga += step( flProjectionSample, (23.0/255.0) ) * step( (22.5/255.0), flProjectionSample );

	
	return cOut;
}
