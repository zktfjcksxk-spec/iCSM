#include "common_ps_fxc.h"

sampler Tex1Sampler : register( s0 );
sampler Tex2Sampler : register( s1 );

const float4 g_Const0 : register( c0 );

struct PS_INPUT
{
	float2 vBaseUV : TEXCOORD0;
};

float4 main( PS_INPUT i ) : COLOR
{	
	float2 vUV = i.vBaseUV;
	
	float flAlpha = tex2D( Tex2Sampler, vUV ).g;
	
	clip( flAlpha - g_Const0.x );
	
	float4 cOut = tex2D( Tex1Sampler, vUV );
	
	//float flEdgeDark = smoothstep( g_Const0.x, g_Const0.x + 0.04f, flAlpha );
	//cOut.rgb *= flEdgeDark;
	
	//float flEdgeRed = smoothstep( g_Const0.x, g_Const0.x + 0.005f, flAlpha );
	//cOut.rgb = lerp( float3(1,1,1), cOut.rgb, flEdgeRed);
	
	cOut.a = 1;
	
	return cOut;
}

