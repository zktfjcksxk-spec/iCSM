ivp_physics.hxx
\par {\pntext\pard\plain\f14\fs22\lang1033\cgrid \loch\af14\dbch\af0\hich\f14 \'a7\tab}}\pard \qj\fi-360\li360\widctlpar\jclisttab\tx360{\*\pn \pnlvlblt\ilvl0\ls66\pnrnot0\pnf14\pnstart1\pnindent360\pnhang{\pntxtb \'a7}}\ls66\adjustright {ivp_material.hxx

