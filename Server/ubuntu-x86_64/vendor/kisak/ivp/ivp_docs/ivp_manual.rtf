00000000000000000000000000001c010000e8200000000000008c0000000100000000000000000000000000000000000000000000000042000000fa02000000000000ffff0000220000000000000101000000000000010000000000000002d6ff000000000000900100000000000000200072696100000000000000000001
00000000000000021000000000000000bc02000000000002022200797374006d00000000000000010300000000000000000000010000000000000002dfff000000000000bc02000000000000002200726961}}}{\fldrslt }}{\cell // input \line IVP_U_Point *pos_object_space; \line 
IVP_U_Matrix *m_world_f_object; 
\par // output \line IVP_U_Point pos_world_space; 
\par m_world_f_object.vmult4(pos_object_space, &pos_world_space) \cell }\pard\plain \widctlpar\intbl\adjustright \f1\fs22\cgrid {\row }\pard \qj\widctlpar\adjustright {
