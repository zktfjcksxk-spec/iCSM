<root>
    <styles>
        <include src="file://{resources}/styles/csgostyles.css" />
        <include src="file://{resources}/styles/settings/settings.css" />
        <include src="file://{resources}/styles/mainmenu.css" />
        <include src="file://{resources}/styles/mainmenu_inventory.css" />
        <include src="file://{resources}/styles/settings/settings_mobile.css" />
    </styles>
    <scripts><include src="file://{resources}/scripts/settingsmenu_shared.js" /><include src="file://{resources}/scripts/settings_quality.js" /></scripts>
    <Panel useglobalcontext="true" class="SettingsMenuTab ICSMMobileSettings">
        <CSGOVideoSettings id="ICSMSettingsScrollViewport" class="SettingsMenuTabContent vscroll">
            <Panel id="SettingsVideo" class="SettingsBackground" onload="ICSMQualitySettings.Init();">
                <Panel class="SettingsSectionTitleContianer"><Label class="SettingsSectionTitleLabel" text="画质预设" /></Panel>
                <Panel class="ICSMQualityPresets">
                    <Button id="ICSMQualityVeryLow" class="ICSMQualityTier" onactivate="ICSMQualitySettings.Select(0);"><Label text="极低" /><Label class="ICSMQualityTierNote" text="480p → 720p" /></Button>
                    <Button id="ICSMQualityLow" class="ICSMQualityTier" onactivate="ICSMQualitySettings.Select(1);"><Label text="低" /><Label class="ICSMQualityTierNote" text="720p" /></Button>
                    <Button id="ICSMQualityMedium" class="ICSMQualityTier" onactivate="ICSMQualitySettings.Select(2);"><Label text="中" /><Label class="ICSMQualityTierNote" text="手机实测 · 屏幕适配" /></Button>
                    <Button id="ICSMQualityHigh" class="ICSMQualityTier" onactivate="ICSMQualitySettings.Select(3);"><Label text="高" /><Label class="ICSMQualityTierNote" text="保留现有分辨率" /></Button>
                </Panel>
                <Label class="ICSMVideoPresetNote" text="中档采用手机实测优化方案，保留地图贴图和烘焙光照；低档与极低档进一步降低场景细节。武器画质、动态模糊与帧率独立保存。" />
                <Panel class="horizontal-separator" />
                <Panel class="SettingsMenuDropdownContainer"><Label text="帧率上限" class="half-width" /><CSGOSettingsEnumDropDown id="ICSMFrameRateLimit" class="PopupButton White" convar="icsm_fps_limit" onuserinputsubmit="GameInterfaceAPI.ConsoleCommand(&quot;host_writeconfig&quot;);">
                            <Label text="60 帧" value="60" id="icsmfps60" />
                            <Label text="90 帧" value="90" id="icsmfps90" />
                            <Label text="120 帧" value="120" id="icsmfps120" />
                        </CSGOSettingsEnumDropDown>
                    </Panel>
                <Label id="ICSMQualityFrameNote" class="ICSMVideoPresetNote" text="极低档固定基础60帧；其他档位可选60／90／120帧。" />
                <Panel class="SettingsMenuDropdownContainer"><Label text="MetalFX 插帧" class="half-width" /><CSGOSettingsEnumDropDown id="ICSMFrameInterpolation" class="PopupButton White" convar="icsm_metal_frame_interpolation" onuserinputsubmit="GameInterfaceAPI.ConsoleCommand(&quot;host_writeconfig&quot;);">
                    <Label text="关闭" value="0" id="icsmfg0" /><Label text="开启（60 → 120）" value="1" id="icsmfg1" />
                </CSGOSettingsEnumDropDown></Panel>
                <Label id="ICSMInterpolationNote" class="ICSMVideoPresetNote" text="基础60帧时可开启插帧，需设备支持；实际显示帧率随场景负载变化。" />
                <Panel class="SettingsMenuDropdownContainer"><Label text="插帧性能测试" class="half-width" /><Button id="ICSMFrameCalibration" class="PopupButton White" onactivate="GameInterfaceAPI.ConsoleCommand(&quot;icsm_frame_calibration&quot;);"><Label text="测试当前设备" /></Button></Panel>
                <Label class="ICSMVideoPresetNote" text="按当前画质重复跑图和机器人场景，测量真实帧率与显示帧间隔；查看结果后手动应用推荐插帧参数。" />
            </Panel>
            <Panel id="SettingsVideoAdvanced" class="SettingsBackground">
                <Panel class="SettingsSectionTitleContianer"><Label class="SettingsSectionTitleLabel" text="高级视频选项" /></Panel>
                <Panel class="top-bottom-flow full-width">
                    <Panel class="SettingsMenuDropdownContainer">
                        <Label text="动态模糊" class="half-width" />
                        <CSGOSettingsEnumDropDown id="MotionBlur" class="PopupButton White" convar="mat_motion_blur_enabled" onuserinputsubmit="GameInterfaceAPI.ConsoleCommand(&quot;mat_savechanges; host_writeconfig&quot;);">
                            <Label text="关闭" value="0" id="motionblur0" /><Label text="开启" value="1" id="motionblur1" />
                        </CSGOSettingsEnumDropDown>
                    </Panel>
                    <Panel class="horizontal-separator" />
                    <Panel class="SettingsMenuDropdownContainer"><Label text="武器光影细节" class="half-width" /><CSGOSettingsEnumDropDown id="ICSMSkinShaderDetail" class="PopupButton White" convar="icsm_skin_shader_detail" onuserinputsubmit="GameInterfaceAPI.ConsoleCommand(&quot;host_writeconfig&quot;);">
                            <Label text="跟随全局光影" value="0" id="icsmskinshader0" />
                            <Label text="高" value="1" id="icsmskinshader1" />
                        </CSGOSettingsEnumDropDown>
                    </Panel>
                    <Panel class="horizontal-separator" />
                    <Panel class="SettingsMenuDropdownContainer"><Label text="武器贴图细节" class="half-width" /><CSGOSettingsEnumDropDown id="ICSMSkinTextureDetail" class="PopupButton White" convar="icsm_skin_texture_detail" onuserinputsubmit="GameInterfaceAPI.ConsoleCommand(&quot;host_writeconfig&quot;);">
                            <Label text="跟随全局贴图" value="0" id="icsmskintexture0" />
                            <Label text="低" value="1" id="icsmskintexture1" />
                            <Label text="中" value="2" id="icsmskintexture2" />
                            <Label text="高" value="3" id="icsmskintexture3" />
                        </CSGOSettingsEnumDropDown>
                    </Panel>
                    <Label class="ICSMVideoPresetNote" text="武器光影和贴图独立保存，切换画质预设时保留你的选择。" />
                </Panel>
            </Panel>
            <!-- Required by Source's original CSGOVideoSettings panel. They
                 have no visible rows, touch targets, reset or apply actions. -->
            <Panel id="ICSMVideoInternal" visible="false" hittest="false" hittestchildren="false"><CSGOSettingsEnumDropDown onuserinputsubmit="SettingsMenuShared.VideoSettingsOnUserInputSubmit()" class="PopupButton White" id="ColorMode">
                            <Label text="#GameUI_DisplayMonitor" value="0" id="tvmode0" />
                            <Label text="#GameUI_DisplayTV" value="1" id="tvmode1" />
                        </CSGOSettingsEnumDropDown>
                    
<CSGOSettingsSlider id="brightness" text="#GameUI_Brightness" max="2.6" min="1.6" invert="true" percentage="true" value100percent="2.0" convar="mat_monitorgamma" />
                    
<CSGOSettingsEnumDropDown onuserinputsubmit="SettingsMenuShared.VideoSettingsOnUserInputSubmit()" class="PopupButton White" id="AspectRatioEnum" oninputsubmit="CSGOAspectRatioSelectionChanged()">
                            <Label text="#SFUI_Settings_Normal" value="0" id="aspectratio0" />
                            <Label text="宽屏（16:9 / 手机屏幕）" value="1" id="aspectratio1" />
                            <Label text="#SFUI_Settings_Widescreen_16_10" value="2" id="aspectratio2" />
                        </CSGOSettingsEnumDropDown>
                    
<CSGOSettingsEnumDropDown onuserinputsubmit="SettingsMenuShared.VideoSettingsOnUserInputSubmit()" class="PopupButton White" id="ResolutionEnum" oninputsubmit="CSGOResolutionSelectionChanged()">
                            <Label value="0" id="resolution0" />
                        </CSGOSettingsEnumDropDown>
                    
<CSGOSettingsEnumDropDown class="PopupButton White" id="DisplayModeEnum">
                    <Label text="#SFUI_Settings_Windowed" value="0" id="displaymode0" />
                    <Label text="#SFUI_Settings_Fullscreen" value="1" id="displaymode1" />
                    <Label text="#SFUI_Settings_Fullscreen_Windowed" value="2" id="displaymode2" />
                </CSGOSettingsEnumDropDown>
                
<CSGOSettingsEnumDropDown class="PopupButton White" id="PowerSavingsMode">
                    <Label text="#SFUI_Settings_Disabled" value="0" id="laptoppower0" />
                    <Label text="#SFUI_Settings_Enabled" value="1" id="laptoppower1" />
                </CSGOSettingsEnumDropDown>
                
<CSGOSettingsEnumDropDown onuserinputsubmit="SettingsMenuShared.VideoSettingsOnUserInputSubmit()" class="PopupButton White" id="CSMQualityLevel">
                            <Label text="#SFUI_CSM_Low" value="0" id="csmqualitylevel0" />
                            <Label text="#SFUI_CSM_Med" value="1" id="csmqualitylevel1" />
                            <Label text="#SFUI_CSM_High" value="2" id="csmqualitylevel2" />
                            <Label text="#SFUI_CSM_VeryHigh" value="3" id="csmqualitylevel3" />
                            <Label text="#SFUI_Settings_Choice_Autodetect" value="9999999" id="csmqualitylevel4" />
                        </CSGOSettingsEnumDropDown>
                    
<CSGOSettingsEnumDropDown onuserinputsubmit="SettingsMenuShared.VideoSettingsOnUserInputSubmit()" class="PopupButton White" id="ModelTextureDetail">
                            <Label text="#SFUI_Settings_Low" value="0" id="gpumemlevel0" />
                            <Label text="#SFUI_Settings_Medium" value="1" id="gpumemlevel1" />
                            <Label text="#SFUI_Settings_High" value="2" id="gpumemlevel2" />
                            <Label text="#SFUI_Settings_Choice_Autodetect" value="9999999" id="gpumemlevel3" />
                        </CSGOSettingsEnumDropDown>
                    
<CSGOSettingsEnumDropDown onuserinputsubmit="SettingsMenuShared.VideoSettingsOnUserInputSubmit()" class="PopupButton White" id="EffectDetail">
                            <Label text="#SFUI_Settings_Low" value="0" id="cpulevel0" />
                            <Label text="#SFUI_Settings_Medium" value="1" id="cpulevel1" />
                            <Label text="#SFUI_Settings_High" value="2" id="cpulevel2" />
                            <Label text="#SFUI_Settings_Choice_Autodetect" value="9999999" id="cpulevel3" />
                        </CSGOSettingsEnumDropDown>
                    
<CSGOSettingsEnumDropDown onuserinputsubmit="SettingsMenuShared.VideoSettingsOnUserInputSubmit()" class="PopupButton White" id="ShaderDetail">
                            <Label text="#SFUI_Settings_Low" value="0" id="gpulevel0" />
                            <Label text="#SFUI_Settings_Medium" value="1" id="gpulevel1" />
                            <Label text="#SFUI_Settings_High" value="2" id="gpulevel2" />
                            <Label text="#SFUI_Settings_Very_High" value="3" id="gpulevel3" />
                            <Label text="#SFUI_Settings_Choice_Autodetect" value="9999999" id="gpulevel4" />
                        </CSGOSettingsEnumDropDown>
                    
<CSGOSettingsEnumDropDown onuserinputsubmit="SettingsMenuShared.VideoSettingsOnUserInputSubmit()" class="PopupButton White" id="FilteringMode">
                            <Label text="#SFUI_Settings_Bilinear" value="0" id="matforceaniso0" />
                            <Label text="#SFUI_Settings_Trilinear" value="1" id="matforceaniso1" />
                            <Label text="#SFUI_Settings_Anisotropic_2X" value="2" id="matforceaniso2" />
                            <Label text="#SFUI_Settings_Anisotropic_4X" value="4" id="matforceaniso3" />
                            <Label text="#SFUI_Settings_Anisotropic_8X" value="8" id="matforceaniso4" />
                            <Label text="#SFUI_Settings_Anisotropic_16X" value="16" id="matforceaniso5" />
                            <Label text="#SFUI_Settings_Choice_Autodetect" value="9999999" id="matforceaniso6" />
                        </CSGOSettingsEnumDropDown>
                    
<CSGOSettingsEnumDropDown class="PopupButton White" id="AAMode">
                    <Label value="0" id="antialisaing0" />
                    <Label value="1" id="antialiasing1" />
                </CSGOSettingsEnumDropDown>
                
<CSGOSettingsEnumDropDown onuserinputsubmit="SettingsMenuShared.VideoSettingsOnUserInputSubmit()" class="PopupButton White" id="FXAA">
                            <Label text="#SFUI_FXAA_Disabled" value="0" id="fxaa0" />
                            <Label text="#SFUI_FXAA_Enabled" value="1" id="fxaa1" />
                        </CSGOSettingsEnumDropDown>
                    
<CSGOSettingsEnumDropDown class="PopupButton White" id="VSync">
                    <Label text="#SFUI_Settings_Disabled" value="0" id="vsync0" />
                    <Label text="#SFUI_Settings_Enabled_Double" value="1" id="vsync1" />
                    <Label text="#SFUI_Settings_Enabled_Triple" value="2" id="vsync2" />
                </CSGOSettingsEnumDropDown>
            
<CSGOSettingsEnumDropDown class="PopupButton White" id="MatQueueMode">
                    <Label text="#SFUI_Settings_Disabled" value="0" id="multicore0" />
                    <Label text="#SFUI_Settings_Enabled" value="-1" id="multicore1" />
                </CSGOSettingsEnumDropDown>
                </Panel>
        </CSGOVideoSettings>
        <Panel id="ICSMVideoActionsInternal" visible="false" hittest="false" hittestchildren="false">
            <Button id="BtnDiscardVideoSettingChanges" enabled="false" />
            <Button id="BtnApplyVideoSettings" enabled="false" />
        </Panel>
    </Panel>
</root>
