<root>
    <styles>
        <include src="file://{resources}/styles/csgostyles.css" />
        <include src="file://{resources}/styles/mainmenu.css" />
        <include src="file://{resources}/styles/inventory_offline.css" />
    </styles>
    <scripts><include src="file://{resources}/scripts/inventory_offline.js" /></scripts>
    <Panel class="mainmenu-content__container offline-inventory" useglobalcontext="true">
      <Panel id="OfflineInventorySourceContent" class="offline-inventory-source-content">
        <Panel class="offline-inventory-header">
            <Button id="OfflineInventoryBack" class="offline-inventory-back" onactivate="OfflineInventory.Back();"><Label text="‹ 返回库存" /></Button>
            <Panel class="offline-inventory-filters">
                <Button id="OfflineCategory_all" onactivate="OfflineInventory.SetCategory('all');"><Label text="全部" /></Button>
                <Button id="OfflineCategory_secondary" onactivate="OfflineInventory.SetCategory('secondary');"><Label text="手枪" /></Button>
                <Button id="OfflineCategory_smg" onactivate="OfflineInventory.SetCategory('smg');"><Label text="冲锋枪" /></Button>
                <Button id="OfflineCategory_rifle" onactivate="OfflineInventory.SetCategory('rifle');"><Label text="步枪" /></Button>
                <Button id="OfflineCategory_sniper" onactivate="OfflineInventory.SetCategory('sniper');"><Label text="狙击枪" /></Button>
                <Button id="OfflineCategory_shotgun" onactivate="OfflineInventory.SetCategory('shotgun');"><Label text="霰弹枪" /></Button>
                <Button id="OfflineCategory_machinegun" onactivate="OfflineInventory.SetCategory('machinegun');"><Label text="机枪" /></Button>
                <Button id="OfflineCategory_melee" onactivate="OfflineInventory.SetCategory('melee');"><Label text="刀具" /></Button>
                <Button id="OfflineCategory_gloves" onactivate="OfflineInventory.SetCategory('gloves');"><Label text="手套" /></Button>
            </Panel>
            <Label id="OfflineInventoryTitle" text="" />
        </Panel>
        <Label id="OfflineInventoryHint" class="offline-inventory-hint" text="点按选择皮肤 · 长按查看阵营／装备" />
        <Panel id="OfflineInventoryItems" class="offline-inventory-items" />
        <Panel id="OfflineInventoryNativeActions" class="offline-inventory-native-actions" hittest="false" hittestchildren="false" />
        <Panel id="OfflineSkinPage" class="offline-skin-page">
            <Panel class="offline-skin-header">
                <Image id="OfflineSkinWeaponImage" />
                <Panel class="offline-skin-details">
                    <Label id="OfflineSkinTeam" /><Label id="OfflineSkinSelectionName" />
                    <Panel class="offline-skin-teams">
                        <Button id="OfflineSkinCT" onactivate="OfflineInventory.SetSkinTeam(3);"><Label text="警方" /></Button>
                        <Button id="OfflineSkinT" onactivate="OfflineInventory.SetSkinTeam(2);"><Label text="匪徒" /></Button>
                    </Panel>
                </Panel>
            </Panel>
            <Label id="OfflineSkinHint" class="offline-inventory-hint" />
            <Panel id="OfflineSkinChoices" class="offline-skin-choices" />
            <Panel class="offline-skin-footer">
                <Panel class="offline-skin-pagination">
                    <Button id="OfflineSkinPrevious" onactivate="OfflineInventory.ChangeSkinPage(-1);"><Label text="‹ 上一页" /></Button>
                    <Label id="OfflineSkinPageNumber" />
                    <Button id="OfflineSkinNext" onactivate="OfflineInventory.ChangeSkinPage(1);"><Label text="下一页 ›" /></Button>
                </Panel>
                <Button id="OfflineSkinConfirm" class="offline-skin-confirm" onactivate="OfflineInventory.Confirm();"><Label id="OfflineSkinConfirmText" text="确认并装备" /></Button>
            </Panel>
        </Panel>
        <Label id="OfflineInventoryStatus" class="offline-inventory-status" />
      </Panel>
    </Panel>
</root>
